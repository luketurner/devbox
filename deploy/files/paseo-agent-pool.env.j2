# Sandbox microVM pool geometry. Generated by `devbox.py provision` -- change it
# with --agent-pool-size / --agent-memory rather than by hand, since the next
# provision overwrites this file.
#
# Read by both paseo-agent-build (which stocks the pool) and paseo-agent-vm
# (which claims from it and rebuilds a used machine). They previously carried
# their own copies of these numbers with a "must match" comment between them,
# which is exactly the kind of agreement that stops holding.
#
# Shell syntax: paseo-agent-build sources this directly, and paseo-agent-vm
# parses the same KEY=value form.

# Machines in the pool, named paseo-agent-1 .. paseo-agent-N. One per concurrent
# sandboxed session; a session beyond this is refused rather than left to the
# OOM killer.
POOL_SIZE={{ agent_pool_size }}

# Per machine. MEM is MiB, matching smolvm's --mem.
CPUS=2
MEM={{ agent_memory }}
