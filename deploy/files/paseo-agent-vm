#!/usr/bin/env python3
"""Launch a Paseo agent inside a sandboxed smolvm microVM.

Paseo's resolveProviderLaunch treats a configured `command` as the binary plus a
*prefix* of the argv and appends the adapter's own per-session arguments
(--resume=<uuid>, --model, --settings {...}) after it. So this wrapper must be
argv-transparent: forward argv verbatim to the guest.

There is no ${workspace} placeholder in Paseo's provider config, but the agent is
spawned with cwd set to the workspace, so os.getcwd() is how we learn what to
mount.

Why a pool rather than a fresh ephemeral VM per session
-------------------------------------------------------
Paseo aborts agent start after AGENT_RUN_START_TIMEOUT_MS = 15000 -- a hardcoded
constant in @getpaseo/server with no config or env override -- and surfaces the
failure as a bare "timeout". A `machine run` boots in 16.3s here even on an idle
box, because smolvm re-flattens the image inside the guest on every boot. That is
not fixable by changing how the image is delivered: a packed .smolmachine measured
26.1s and --oci-cache 25.7s (which also writes progress to stdout, corrupting the
protocol stream). Nor by shrinking the image -- 324MB of it is the single claude
binary.

A machine that has already been flattened once starts in ~1.6s and execs in well
under a second, which fits the budget with room to spare. So we keep a small pool
of pre-flattened machines, claim one per session, and mount only that session's
workspace into it. `machine exec` has no --volume, so mounts are swapped while the
machine is stopped -- which is instant.

To keep the per-session freshness an ephemeral VM would have given, a used machine
is destroyed and rebuilt in the background *after* the session ends, off the
critical path. A claimed machine is therefore always a fresh rootfs.
"""

import json
import os
import signal
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
SMOLVM = os.path.join(HOME, ".smolvm/smolvm")
EGRESS_BIN = os.path.join(HOME, ".local/bin/paseo-agent-egress")
IMAGE = os.path.join(HOME, ".local/share/paseo-agent.tar")
VERSION_FILE = os.path.join(HOME, ".local/share/paseo-agent.version")
STATE_DIR = os.path.join(HOME, ".cache/paseo-agent-vm")
RECYCLE_LOG = os.path.join(STATE_DIR, "recycle.log")

# Pool geometry, shared with paseo-agent-build via a file the deploy generates
# from `provision --agent-pool-size / --agent-memory`. Both scripts have to
# agree on machine names and on --mem, and they used to do that by each holding
# a copy under a "must match" comment.
POOL_CONF = os.path.join(HOME, ".config/paseo-agent/pool.env")

# The defaults the deploy ships. Only reached if pool.env is missing -- a
# half-finished provision, say -- where refusing to start would take every
# sandboxed session down with it. One machine per concurrent session; a box
# running the daemon plus an installed Hub and Postgres fits two on 2 vCPU /
# 8 GiB, and past that the OOM killer decides. It has killed a microVM here once.
POOL_DEFAULTS = {"POOL_SIZE": "2", "CPUS": "2", "MEM": "2048"}


def log(msg):
    print("paseo-agent-vm: %s" % msg, file=sys.stderr)


def read_pool_conf(path=POOL_CONF):
    """Parse the KEY=value pairs paseo-agent-build sources as shell."""
    values = dict(POOL_DEFAULTS)
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                values[key.strip()] = value.strip().strip("\"'")
    except OSError as err:
        log("%s unreadable (%s); using built-in pool defaults" % (path, err))
    return values


_pool = read_pool_conf()
# Named paseo-agent-1..N, matching how paseo-agent-build stocks them.
POOL = ["paseo-agent-%d" % i for i in range(1, int(_pool["POOL_SIZE"]) + 1)]
CPUS = _pool["CPUS"]
MEM = _pool["MEM"]

# Dev-server ports forwarded out of the VM. smolvm only ever binds these on the
# host's 127.0.0.1 (it rejects an IP in the spec), so `tailscale serve`
# republishes them onto the tailnet -- see the README.
#
# 3000 is deliberately absent: it stays reserved for Hub on the tailnet even
# where Hub isn't installed, so `devbox.py hub install` can never collide with a
# forwarded port. 8080 is likewise held for the Caddy webhook filter. Run a dev
# server on one of these instead.
PORTS = ["5173", "8000", "8081"]


def smolvm(*args, **kwargs):
    return subprocess.run([SMOLVM, *args], **kwargs)


def egress_flags():
    """The --allow-cidr flags confining a rebuilt machine to the public internet.

    Generated by paseo-agent-egress rather than restated here, so this path and
    the pool build in paseo-agent-build cannot drift into applying different
    policies. Returns None if the list cannot be produced, which the caller
    treats as a reason not to build a machine at all.
    """
    try:
        out = subprocess.run([EGRESS_BIN], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.split() or None


def answer_metadata_probes(argv):
    """Answer Paseo's provider probes on the host, without booting anything.

    Paseo probes with `<command> --version` and `<command> auth status`, each on a
    hard 5s budget (resolveClaudeCodeVersion / resolveClaudeAuth). No microVM
    starts that fast, so before this shortcut every probe failed *and* left a VM
    churning long after Paseo gave up -- which is what buried this box under
    concurrent VMs until the OOM killer stepped in.

    Matching the whole argv is what makes this safe: Paseo launches a real session
    as `--input-format stream-json ... --resume=<uuid>`, so it can never collide.
    """
    if argv == ["--version"]:
        try:
            with open(VERSION_FILE) as fh:
                sys.stdout.write(fh.read())
        except OSError:
            log("%s is missing; run paseo-agent-build" % VERSION_FILE)
            return 1
        return 0
    if argv == ["auth", "status"]:
        print(
            "Sandboxed provider: the guest authenticates with the "
            "CLAUDE_CODE_OAUTH_TOKEN injected at launch."
        )
        return 0
    return None


def check_workspace(workspace):
    """Refuse a cwd that would mount far more than a workspace.

    os.getcwd() is simply whatever we were handed. For a session that is the
    workspace, but a version probe ran from the daemon's own cwd and mounted the
    entire home directory -- ~/.ssh and devbox.env included.
    """
    if workspace in ("", "/", HOME):
        log("refusing to mount %r as a workspace" % workspace)
        return False
    if (HOME + "/").startswith(workspace.rstrip("/") + "/"):
        log("refusing to mount %r, which contains $HOME" % workspace)
        return False
    return True


def git_common_dir(workspace):
    """Resolve the git directory that actually backs this workspace.

    Paseo runs agents in git worktrees, whose .git is a *file* reading
    `gitdir: <mainrepo>/.git/worktrees/<name>`. Mounting only the workspace leaves
    that pointer dangling, and every git command in the guest fails with
    "fatal: not a git repository" -- verified in a guest before this fix.

    rev-parse reports the path absolute for a worktree but as a bare ".git" for a
    plain clone; once resolved, a plain clone's git dir is already inside the
    workspace and needs no second mount.
    """
    try:
        out = subprocess.run(
            ["git", "-C", workspace, "rev-parse", "--git-common-dir"],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    path = out.stdout.strip()
    if not path:
        return None
    if not os.path.isabs(path):
        path = os.path.normpath(os.path.join(workspace, path))
    if not os.path.isdir(path):
        return None
    if path.startswith(workspace.rstrip("/") + "/"):
        return None
    return path


def free_ports():
    """Forward only the ports actually free right now.

    They are fixed host ports, so a second concurrent session would otherwise fail
    the whole launch with "virtio-net: Address already in use". Losing a forward is
    a far smaller loss than losing the agent.

    Only a loopback or wildcard listener actually collides, because that is all
    smolvm binds. An earlier check compared bare port numbers, which also matched
    `tailscale serve`'s listeners on the tailnet address -- so every port looked
    permanently busy and port forwarding was silently disabled altogether.
    """
    try:
        out = subprocess.run(["ss", "-ltnH"], capture_output=True, text=True, timeout=10)
        listening = {line.split()[3] for line in out.stdout.splitlines() if len(line.split()) > 3}
    except (OSError, subprocess.SubprocessError, IndexError):
        return []
    local = ("127.0.0.1", "0.0.0.0", "*", "[::]", "[::1]")
    out_ports = []
    for port in PORTS:
        if any("%s:%s" % (host, port) in listening for host in local):
            log("port %s is in use; not forwarding it" % port)
        else:
            out_ports.append(port)
    return out_ports


def machines():
    try:
        out = smolvm("machine", "ls", "--json", capture_output=True, text=True, timeout=30)
        return {m["name"]: m for m in json.loads(out.stdout)}
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        return {}


def claim():
    """Take exclusive ownership of one pool machine.

    O_CREAT|O_EXCL is the atomic part. A lock whose owning PID is gone is stale --
    a SIGKILLed wrapper cannot release its own lock -- so reclaim it.
    """
    os.makedirs(STATE_DIR, exist_ok=True)
    for name in POOL:
        lock = os.path.join(STATE_DIR, name + ".lock")
        try:
            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        except FileExistsError:
            if not lock_is_stale(lock):
                continue
            try:
                os.unlink(lock)
                fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            except OSError:
                continue
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
        return name, lock
    return None, None


def lock_is_stale(lock):
    try:
        with open(lock) as fh:
            pid = int(fh.read().strip())
    except (OSError, ValueError):
        return True
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False
    return False


def prepare(name, workspace, gitdir):
    """Point a stopped pool machine at this session's workspace and start it."""
    info = machines().get(name)
    if info is None:
        log("pool machine %s does not exist; run paseo-agent-build" % name)
        return False
    if info.get("state") == "running":
        smolvm("machine", "stop", "--name", name, capture_output=True, timeout=120)
    # Only now are this machine's own forwards released, so a machine stranded by
    # a SIGKILLed session does not make its ports look permanently taken.
    ports = free_ports()
    if info.get("mounts"):
        # Recycling should hand us a machine with no mounts. If it did not, the
        # previous session's workspace would still be visible, so refuse rather
        # than leak it across sessions.
        log("pool machine %s has stale mounts; recycling instead of reusing" % name)
        return False

    update = ["machine", "update", "--name", name,
              "--volume", "%s:%s" % (workspace, workspace),
              "--cpus", CPUS, "--mem", MEM, "--net"]
    if gitdir:
        update += ["--volume", "%s:%s" % (gitdir, gitdir)]
    for port in ports:
        update += ["--port", "%s:%s" % (port, port)]
    if smolvm(*update, capture_output=True, timeout=60).returncode != 0:
        log("could not configure pool machine %s" % name)
        return False

    started = smolvm("machine", "start", "--name", name, capture_output=True, text=True, timeout=300)
    if started.returncode != 0:
        log("could not start pool machine %s: %s" % (name, started.stderr.strip()[:200]))
        return False

    # `machine start` can return before the guest container actually accepts
    # execs -- observed when a background rebuild was competing for this box's
    # two cores. Poll for readiness instead of letting the session's first exec
    # die with "the container ... is not running", which would surface to Paseo
    # as the same opaque failure this whole change exists to remove.
    for _ in range(20):
        probe = smolvm("machine", "exec", "--name", name, "--", "/bin/true",
                       capture_output=True, timeout=60)
        if probe.returncode == 0:
            return True
        time.sleep(0.5)
    log("pool machine %s started but never became ready" % name)
    return False


def recycle(name, lock):
    """Destroy and rebuild a used machine, then release the lock.

    Detached and off the critical path: the point of the pool is that the *next*
    session finds an already-flattened machine, and rebuilding costs ~17s. Holding
    the lock until the rebuild finishes is deliberate -- a half-built machine must
    not be claimable.
    """
    egress = egress_flags()
    if egress is None:
        # Fail closed. A machine created without the allowlist would come back
        # with unrestricted egress -- the tailnet included -- and look identical
        # to a good one, so the next session would silently get a weaker sandbox
        # than the one it replaced. Leaving the pool a machine short is visible
        # (prepare() says so) and paseo-agent-build restocks it.
        log("cannot generate egress allowlist; leaving %s unbuilt, run paseo-agent-build" % name)
        script = (
            '"$1" machine stop --name "$2" >/dev/null 2>&1;'
            '"$1" machine delete --name "$2" -f >/dev/null 2>&1;'
            'rm -f "$3"'
        )
        args = ["/bin/sh", "-c", script, "sh", SMOLVM, name, lock]
    else:
        # $7 is deliberately unquoted: it is the flag list, one word per flag.
        script = (
            '"$1" machine stop --name "$2" >/dev/null 2>&1;'
            '"$1" machine delete --name "$2" -f >/dev/null 2>&1;'
            '"$1" machine create --name "$2" --image "$3" --net $7 --cpus "$4" --mem "$5" >/dev/null 2>&1 &&'
            '"$1" machine start --name "$2" >/dev/null 2>&1 &&'
            '"$1" machine stop --name "$2" >/dev/null 2>&1;'
            'rm -f "$6"'
        )
        args = ["/bin/sh", "-c", script, "sh", SMOLVM, name, IMAGE, CPUS, MEM,
                lock, " ".join(egress)]
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(RECYCLE_LOG, "ab") as logfh:
            subprocess.Popen(
                args,
                stdin=subprocess.DEVNULL, stdout=logfh, stderr=logfh,
                start_new_session=True,
            )
    except OSError:
        # Never strand the lock just because the rebuild could not be spawned.
        try:
            os.unlink(lock)
        except OSError:
            pass


def main():
    argv = sys.argv[1:]

    probe = answer_metadata_probes(argv)
    if probe is not None:
        return probe

    workspace = os.getcwd()
    if not check_workspace(workspace):
        return 1

    # The daemon already exports this (its own wrapper sources devbox.env and
    # children inherit), but read it too so the wrapper works when run by hand.
    env_file = os.path.join(HOME, ".config/devbox.env")
    if os.path.exists(env_file):
        with open(env_file) as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("export "):
                    line = line[len("export "):]
                if "=" in line and not line.startswith("#"):
                    key, _, value = line.partition("=")
                    os.environ.setdefault(key.strip(), value.strip().strip('"\''))

    # A session killed with SIGKILL cannot clean up after itself, so it leaves its
    # machine running with mounts still attached. That machine is unusable -- its
    # previous workspace must not leak into this session -- but the rest of the
    # pool is fine, so rebuild it and move on rather than failing the session.
    # recycle() holds the lock until the replacement is ready, so the next claim()
    # skips the machine being rebuilt and cannot loop on it.
    gitdir = git_common_dir(workspace)
    name = lock = None
    for _ in range(len(POOL)):
        candidate, candidate_lock = claim()
        if candidate is None:
            break
        if prepare(candidate, workspace, gitdir):
            name, lock = candidate, candidate_lock
            break
        recycle(candidate, candidate_lock)

    if name is None:
        log("no sandbox machine available (all busy, or being rebuilt)")
        return 1

    # --secret-env resolves from our environment at exec time and is never written
    # to the machine record, unlike --env, which also put the token in `ps` output.
    cmd = [SMOLVM, "machine", "exec", "-i", "--name", name, "--workdir", workspace,
           "--secret-env", "CLAUDE_CODE_OAUTH_TOKEN=CLAUDE_CODE_OAUTH_TOKEN",
           "--", "agent-entry", *argv]

    # Inherit stdio untouched: this is the agent's protocol stream.
    child = subprocess.Popen(cmd)

    def forward(signum, _frame):
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, forward)

    try:
        status = child.wait()
    finally:
        smolvm("machine", "stop", "--name", name, capture_output=True, timeout=120)
        recycle(name, lock)
    return status


if __name__ == "__main__":
    sys.exit(main())
