#!/bin/sh
# ExecStart wrapper for the paseo daemon. A script rather than an inline
# ExecStart= because we need command substitution and the env file.
set -e

# systemd never sources .bashrc, and claude lives in ~/.local/bin.
export PATH="$HOME/.local/bin:$PATH"

# Route gh through the exe.dev GitHub integration. .bashrc has the interactive
# copy of this, which the daemon never sees — without it Paseo's "Add project"
# and any gh the daemon runs would hit github.com instead.
export GH_HOST=github.int.exe.xyz

# Claude token the daemon's spawned agents need.
[ -f "$HOME/.config/devbox.env" ] && . "$HOME/.config/devbox.env"

# Bind to the tailnet only, never 0.0.0.0 — the daemon can spawn agents on this
# box. Resolved at start so it survives IP changes.
TS_IP="$(tailscale ip -4 | head -n1)"
export PASEO_LISTEN="${TS_IP}:6767"
export PASEO_HOSTNAMES="${TS_IP},$(hostname)"

# --foreground is load-bearing: without it `paseo daemon start` forks a child
# and returns 0, so systemd sees the Type=simple main process exit cleanly,
# marks the unit dead, and never restarts it because nothing "failed". The
# daemon it forked is then unsupervised and dies with the cgroup.
exec paseo daemon start --foreground --web-ui --no-relay
